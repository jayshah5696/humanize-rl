outputs/
outputs_gemma4_*/

# Experiment tracking and logs
mlruns/
wandb/
mlflow.db
run_direct.log
log/*.log
*.tmp

# Generated scorer intermediates
# Keep curated scorer-ready datasets explicit via git add -f only when needed.
data/scorer/*.bak
data/scorer/l2_labeled_v*.jsonl
data/scorer/l2_labeled_scorer_v01.jsonl
data/scorer/l2_labeling_pool_v01.jsonl

# Local model/checkpoint artifacts
adapters/
models/
*.safetensors
*.pkl
*.npz

# Local tool state
.antigravitycli/

# One-off report/figure generation helpers
scripts/create_track_a_summary_figures.py
scripts/run_track_a_capped_report.py
scripts/run_track_a_full_report.py

# Generated benchmark artifacts (reproducible via `just v03-ws`).
# Source of truth = seeds/ + code + report. Anything emitted by a stage
# stays out of git.
data/benchmark/v03_core.jsonl
data/benchmark/v03_diagnostics.jsonl
data/benchmark/v03_ood_ai.jsonl
data/benchmark/v03_walking_skeleton.jsonl
seeds/v03/*_x2.jsonl
seeds/v03/walking_skeleton_x?.jsonl

# Generated corpus/expansion datasets and seeds
data/benchmark/*_matched.jsonl
data/benchmark/v03_corpus_*.jsonl
seeds/v03/corpus_seeds*.jsonl
seeds/v03/expansion_seeds*.jsonl

# Run dirs are ignored by default. Git negation requires un-ignoring each
# parent before the leaf, hence the four rules below: runs is wholly
# ignored except for the canonical v03 reports.
runs/*
!runs/v03/
runs/v03/*
!runs/v03/v03_report.json
!runs/v03/v03_report.md

# Arka state
state.db
*.db-journal
configs/state.db
configs/runs/
configs/v03/state.db
configs/v03/runs/
configs/v04/runs/

# OS
.DS_Store
Thumbs.db

